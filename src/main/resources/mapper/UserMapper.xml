<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gaoyifeng.aioserver.infrastructure.dao.mapper.UserMapper">

    <!-- 结果映射 -->
    <resultMap id="UserResultMap" type="com.gaoyifeng.aioserver.infrastructure.dao.po.UserPO">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 根据用户名查找用户 -->
    <select id="findByUsername" parameterType="java.lang.String" resultMap="UserResultMap">
        SELECT id, username, password, create_time, update_time
        FROM user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- 根据ID查找用户 -->
    <select id="findById" parameterType="java.lang.String" resultMap="UserResultMap">
        SELECT id, username, password, create_time, update_time
        FROM user
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- 插入新用户 -->
    <insert id="insert" parameterType="com.gaoyifeng.aioserver.infrastructure.dao.po.UserPO">
        INSERT INTO user (id, username, password, create_time, update_time)
        VALUES (#{id}, #{username}, #{password}, #{createTime}, #{updateTime})
    </insert>

    <!-- 更新用户信息 -->
    <update id="update" parameterType="com.gaoyifeng.aioserver.infrastructure.dao.po.UserPO">
        UPDATE user
        SET username = #{username},
            password = #{password},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <!-- 根据用户名统计数量 -->
    <select id="countByUsername" parameterType="java.lang.String" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM user
        WHERE username = #{username}
    </select>

    <!-- 根据ID统计数量 -->
    <select id="countById" parameterType="java.lang.String" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM user
        WHERE id = #{id}
    </select>

</mapper>