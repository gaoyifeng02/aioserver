<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gaoyifeng.aioserver.infrastructure.dao.mapper.WeixinConversationMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.gaoyifeng.aioserver.infrastructure.dao.po.WeixinConversationPO">
        <id column="id" property="id" />
        <result column="conversation_id" property="conversationId" />
        <result column="open_id" property="openId" />
        <result column="original_id" property="originalId" />
        <result column="status" property="status" />
        <result column="first_message_time" property="firstMessageTime" />
        <result column="last_message_time" property="lastMessageTime" />
        <result column="message_count" property="messageCount" />
        <result column="created_time" property="createdTime" />
        <result column="updated_time" property="updatedTime" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, conversation_id, open_id, original_id, status, first_message_time,
        last_message_time, message_count, created_time, updated_time, deleted
    </sql>

    <!-- 根据OpenID查找最近的活跃对话 -->
    <select id="selectLatestByOpenId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM weixin_conversation
        WHERE open_id = #{openId}
        AND status = 1
        AND deleted = 0
        ORDER BY last_message_time DESC
        LIMIT 1
    </select>

    <!-- 根据OpenID查找所有对话 -->
    <select id="selectByOpenId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM weixin_conversation
        WHERE open_id = #{openId}
        AND deleted = 0
        ORDER BY last_message_time DESC
    </select>

    <!-- 更新对话最后消息时间和消息数量 -->
    <update id="updateLastMessageInfo">
        UPDATE weixin_conversation
        SET last_message_time = #{lastMessageTime},
            message_count = message_count + 1,
            updated_time = NOW()
        WHERE conversation_id = #{conversationId}
        AND deleted = 0
    </update>

</mapper>